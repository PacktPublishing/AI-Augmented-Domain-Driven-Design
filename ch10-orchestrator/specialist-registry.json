{
  "eventstormer": {
    "consumes": "raw-evidence",
    "produces": "candidate-facts",
    "requires_gate": null
  },
  "storyteller": {
    "consumes": "accepted-facts",
    "produces": "candidate-scenarios",
    "requires_gate": "eventstormer-review"
  },
  "command-event-writer": {
    "consumes": "accepted-scenarios",
    "produces": "candidate-behavior",
    "requires_gate": "storyteller-review"
  },
  "context-mapper": {
    "consumes": "accepted-behavior",
    "produces": "candidate-context-map",
    "requires_gate": "command-event-writer-review"
  }
}
